<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="22dp" android:paddingBottom="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PANTRY NOTE" android:textColor="#A56845" android:textSize="11sp"
        android:textStyle="bold" android:letterSpacing="0.12"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" android:text="A little detail\nfor later." android:textColor="#263D34"
        android:textSize="28sp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="-2dp"/>
    <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:hint="Ingredient name (e.g. tomatoes)"
        android:inputType="textCapWords" android:padding="15dp" android:background="@drawable/surface_card"
        android:textColor="#263D34" android:textColorHint="#929087"/>
    <EditText android:id="@+id/etQty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:hint="Quantity" android:inputType="numberDecimal"
        android:padding="15dp" android:background="@drawable/surface_card"
        android:textColor="#263D34" android:textColorHint="#929087"/>
    <Spinner android:id="@+id/spUnit" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="10dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:background="@drawable/surface_card"/>
    <EditText android:id="@+id/etExpiry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:hint="Expiry date yyyy-MM-dd (optional)"
        android:inputType="date" android:padding="15dp" android:background="@drawable/surface_card"
        android:textColor="#263D34" android:textColorHint="#929087"/>
    <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="Save to pantry"/>
    <Button android:id="@+id/btnDelete" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Delete ingredient" android:visibility="gone"/>
</LinearLayout>
