<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/pantry_blue</item>
        <item name="colorPrimaryDark">@color/pantry_blue_dark</item>
        <item name="colorAccent">@color/pantry_blue</item>
        <item name="android:windowBackground">@color/pantry_black</item>
        <item name="android:colorBackground">@color/pantry_black</item>
        <item name="android:textColorPrimary">@color/pantry_white</item>
        <item name="android:textColorSecondary">@color/pantry_muted</item>
        <item name="android:statusBarColor">@color/pantry_blue_dark</item>
        <item name="android:navigationBarColor">@color/pantry_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="buttonStyle">@style/PantryButton</item>
    </style>

    <style name="PantryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/pantry_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:elevation">2dp</item>
    </style>
</resources>
